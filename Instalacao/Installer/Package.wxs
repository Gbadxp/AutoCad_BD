<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!--
    Instala o FiberPlugin.bundle em C:\Program Files\Autodesk\ApplicationPlugins, pasta que o
    AutoCAD carrega automaticamente e considera confiável (sem aviso de segurança).
    Os dados do usuário (Documentos\Fiber Plugin) não fazem parte do .msi e nunca são apagados.
  -->
  <Package
      Name="Fiber Plugin para AutoCAD"
      Manufacturer="Fiber Plugin"
      Version="$(var.ProductVersion)"
      UpgradeCode="B4DA7AF3-6EB0-47DD-A9B5-231D6C09AEED"
      Scope="perMachine"
      Language="1046"
      Codepage="1252">

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais nova do Fiber Plugin já está instalada." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPCOMMENTS" Value="Ferramentas para projetos de redes de fibra óptica (FTTH) no AutoCAD 2022-2026" />
    <!-- Contato do autor em Configurações > Aplicativos (link de suporte) -->
    <Property Id="ARPCONTACT" Value="georgegomes_aires@hotmail.com" />
    <Property Id="ARPHELPLINK" Value="mailto:georgegomes_aires@hotmail.com" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="AutodeskFolder" Name="Autodesk">
        <Directory Id="ApplicationPluginsFolder" Name="ApplicationPlugins">
          <Directory Id="INSTALLFOLDER" Name="FiberPlugin.bundle" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Todo o conteúdo do FiberPlugin.bundle montado pelo build.ps1 -->
    <ComponentGroup Id="BundleFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.BundleDir)\**" />
    </ComponentGroup>

    <Feature Id="Main" Title="Fiber Plugin">
      <ComponentGroupRef Id="BundleFiles" />
    </Feature>

    <!-- Assistente simples: boas-vindas + observações + progresso -->
    <WixVariable Id="WixUILicenseRtf" Value="Observacoes.rtf" />
    <!-- Foto e contato do autor: faixa do topo (493 x 58) e painel da tela final (493 x 312) -->
    <WixVariable Id="WixUIBannerBmp" Value="banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="dialog.bmp" />
    <ui:WixUI Id="WixUI_Minimal" />

  </Package>
</Wix>
