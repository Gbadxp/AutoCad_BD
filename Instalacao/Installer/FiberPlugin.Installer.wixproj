<Project Sdk="WixToolset.Sdk/5.0.2">

  <!--
    Instalador .msi do Fiber Plugin. Não rode direto: use Instalacao\build.ps1, que monta o
    FiberPlugin.bundle e passa Version e BundleDir para este projeto.
  -->
  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <BundleDir Condition="'$(BundleDir)' == ''">$(MSBuildThisFileDirectory)..\dist\FiberPlugin.bundle</BundleDir>
    <OutputName>FiberPlugin-$(Version)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Cultures>pt-BR</Cultures>
    <DefineConstants>ProductVersion=$(Version);BundleDir=$(BundleDir)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
